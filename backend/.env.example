# Configurações do Document Management System Backend
# Copie este arquivo para .env e preencha com valores específicos do seu ambiente

# Porta do servidor Express
PORT=3000

# Ambiente de execução (development, production)
NODE_ENV=development

# Diretório de armazenamento de arquivos
STORAGE_PATH=./backend/storage

# Tamanho máximo de arquivo em bytes (padrão: 10485760 = 10MB)
MAX_FILE_SIZE=10485760

# Configurações de CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
